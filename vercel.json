{
  "rewrites": [
    {
      "source": "/xadsblueprint",
      "destination": "https://xads-site.vercel.app/"
    },
    {
      "source": "/xadsblueprint/:path*",
      "destination": "https://vercel.app*"
    },
    {
      "source": "/TRCC",
      "destination": "/trcc.html"
    },
    {
      "source": "/trcc",
      "destination": "/trcc.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}